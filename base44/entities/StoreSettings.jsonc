{
  "name": "StoreSettings",
  "type": "object",
  "properties": {
    "store_name": {
      "type": "string",
      "description": "Nome do estabelecimento",
      "default": "Smoke Bebidas"
    },
    "cep": {
      "type": "string",
      "description": "CEP da loja"
    },
    "street": {
      "type": "string",
      "description": "Rua/Logradouro da loja"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero do endere\u00e7o da loja"
    },
    "complement": {
      "type": "string",
      "description": "Complemento do endere\u00e7o da loja"
    },
    "district": {
      "type": "string",
      "description": "Bairro da loja"
    },
    "city": {
      "type": "string",
      "description": "Cidade da loja"
    },
    "state": {
      "type": "string",
      "description": "Estado (UF) da loja"
    },
    "lat": {
      "type": "number",
      "description": "Latitude da loja"
    },
    "lng": {
      "type": "number",
      "description": "Longitude da loja"
    },
    "freight_table": {
      "type": "array",
      "description": "Tabela de frete por dist\u00e2ncia (faixas personalizadas). A maior faixa funciona como limite m\u00e1ximo de entrega.",
      "items": {
        "type": "object",
        "properties": {
          "distance_km": {
            "type": "number",
            "description": "Dist\u00e2ncia m\u00e1xima da faixa em KM"
          },
          "price": {
            "type": "number",
            "description": "Valor do frete para esta faixa"
          }
        }
      },
      "default": []
    },
    "freight_per_km": {
      "type": "number",
      "default": 2.5,
      "description": "Valor do frete por KM rodado (fallback quando n\u00e3o h\u00e1 tabela)"
    },
    "min_freight": {
      "type": "number",
      "default": 0,
      "description": "Valor m\u00ednimo do frete (se 0, sem m\u00ednimo) \u2014 usado apenas no modo por KM"
    },
    "free_freight_threshold": {
      "type": "number",
      "default": 0,
      "description": "Pedidos acima deste valor t\u00eam frete gr\u00e1tis (se 0, desativado)"
    },
    "max_delivery_radius_km": {
      "type": "number",
      "default": 0,
      "description": "Raio m\u00e1ximo de entrega em KM (fallback quando n\u00e3o h\u00e1 tabela)"
    },
    "estimated_delivery_minutes": {
      "type": "number",
      "default": 30,
      "description": "Tempo estimado de entrega em minutos"
    },
    "delivery_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Entregas habilitadas"
    },
    "delivery_city": {
      "type": "string",
      "description": "Cidade onde a loja faz entregas",
      "default": "Gravata\u00ed"
    },
    "delivery_state": {
      "type": "string",
      "description": "Estado (UF) onde a loja faz entregas",
      "default": "RS"
    }
  },
  "required": [
    "store_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}